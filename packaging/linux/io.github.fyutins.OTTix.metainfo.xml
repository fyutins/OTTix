<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.fyutins.OTTix</id>

  <name>OTTix</name>
  <summary>Player for M3U and Xtream Codes IPTV streams</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="io.github.fyutins">
    <name>Fyutins</name>
  </developer>

  <description>
    <p>
      OTTix plays M3U channel lists and Xtream Codes accounts. Playback is
      backed by libmpv, with hardware decoding when it is available.
    </p>
    <p>Features:</p>
    <ul>
      <li>Import M3U playlists (file or URL) and Xtream Codes accounts</li>
      <li>Multiplex: up to four simultaneous streams, selectable layouts</li>
      <li>Automatic grouping of channels by quality (SD, HD, FHD, 4K)</li>
      <li>Favorites, history and instant search</li>
      <li>Sleep inhibition during playback</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.fyutins.OTTix.desktop</launchable>

  <url type="homepage">https://github.com/fyutins/OTTix</url>
  <url type="bugtracker">https://github.com/fyutins/OTTix/issues</url>

  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Player</category>
    <category>TV</category>
  </categories>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <content_rating type="oars-1.1"/>

